---
import Base from '../layouts/Base.astro';
import QuoteForm from '../components/QuoteForm';
---
<Base title="Get started" description="Request a quote or start a project with Almost Final.">
  <section class="section"><div class="container" style="max-width:760px">
    <p class="eyebrow">Get started</p>
    <h1 style="margin:12px 0 20px">Tell us what you are building</h1>
    <p class="lead" style="margin-bottom:32px">Five quick questions. We will reply with next steps.</p>
    <QuoteForm client:load />
  </div></section>
</Base>
