---
import Base from '../layouts/Base.astro';
---
<Base title="Work" description="Selected projects from Almost Final. Published only with client permission.">
  <section class="section"><div class="container">
    <p class="eyebrow">Work</p>
    <h1 style="margin:12px 0 32px">Selected work</h1>
    <div class="empty">
      <img src="/brand/mascot.svg" alt="" width="140" height="140" style="margin:0 auto 20px" />
      <h2 style="font-size:1.75rem">No projects published yet</h2>
      <p class="lead" style="margin:12px auto 24px">The studio publishes real work only, with the client’s permission.</p>
      <a class="btn btn--primary" href="/contact">Start the first project with us</a>
    </div>
  </div></section>
</Base>
