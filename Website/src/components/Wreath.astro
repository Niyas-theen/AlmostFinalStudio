---
const N = 46;
const leaves = Array.from({ length: N }, (_, i) => {
  const a = (i / N) * Math.PI * 2;
  const x = 50 + 47 * Math.cos(a), y = 69.5 + 66 * Math.sin(a);
  const rot = (Math.atan2(66 * Math.cos(a), -47 * Math.sin(a)) * 180) / Math.PI;
  return { x, y, rot, c: i % 3 === 0 ? '#2f9a5b' : i % 3 === 1 ? '#1c6b46' : '#4fb26f' };
});
const berries = Array.from({ length: 14 }, (_, i) => {
  const a = (i / 14) * Math.PI * 2 + 0.2;
  return [50 + 47 * Math.cos(a), 69.5 + 66 * Math.sin(a)];
});
---
<svg class="wreath" viewBox="0 0 100 139" aria-hidden="true">
  <ellipse cx="50" cy="69.5" rx="47" ry="66" fill="none" stroke="#124a31" stroke-width="3" />
  {leaves.map((l) => <ellipse cx={l.x} cy={l.y} rx="7" ry="2.8" fill={l.c} transform={`rotate(${l.rot + 25} ${l.x} ${l.y})`} />)}
  {leaves.map((l) => <ellipse cx={l.x} cy={l.y} rx="7" ry="2.8" fill={l.c} opacity=".9" transform={`rotate(${l.rot - 25} ${l.x} ${l.y})`} />)}
  {berries.map(([x, y]) => <circle cx={x} cy={y} r="2.2" fill="#e63946" />)}
  <g transform="translate(50 138)"><path d="M0 0 C-14 -10 -20 6 -6 4Z M0 0 C14 -10 20 6 6 4Z" fill="#e63946" transform="translate(0 -5)" /><circle cy="-3" r="3.2" fill="#b3121f" /></g>
</svg>
