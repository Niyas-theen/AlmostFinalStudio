---
import type { Service } from '../data/site';
const { s } = Astro.props as { s: Service };
---
<a class="card card--link reveal" href={`/services/${s.slug}`}>
  <h3>{s.name}</h3>
  <p class="muted" style="margin-top:8px">{s.outcome}</p>
  <span style="display:inline-block;margin-top:16px;color:var(--green-dark)">Explore {s.name} →</span>
</a>
