---
/** Experience side: Figma-style frame with selection, layers panel, collaborator cursor, code tile. */
---
<svg class="hx hx--r" viewBox="0 0 280 230" role="img" aria-label="Design tools: an interface frame with selection handles, a layers panel, a collaborator cursor and a code tile">
  <defs>
    <linearGradient id="r-ui" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#075392" /><stop offset="1" stop-color="#2a79bd" /></linearGradient>
    <linearGradient id="r-red" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#ff7b85" /><stop offset="1" stop-color="#b3121f" /></linearGradient>
    <linearGradient id="r-gloss" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#fff" stop-opacity=".6" /><stop offset="1" stop-color="#fff" stop-opacity="0" /></linearGradient>
    <filter id="r-sh" x="-30%" y="-30%" width="170%" height="180%"><feDropShadow dx="0" dy="10" stdDeviation="9" flood-color="#000" flood-opacity=".4" /></filter>
  </defs>
  <g filter="url(#r-sh)"><rect x="44" y="18" width="200" height="132" rx="16" fill="#fff" fill-opacity=".12" stroke="#fff" stroke-opacity=".3" /></g>
  <rect x="56" y="30" width="176" height="14" rx="7" fill="#fff" fill-opacity=".4" />
  <rect x="56" y="52" width="176" height="46" rx="10" fill="url(#r-ui)" />
  <g fill="#fff" fill-opacity=".24">{[56, 117, 178].map((x) => <rect x={x} y="106" width="54" height="34" rx="8" />)}</g>
  <g fill="none" stroke="#8fd3ff" stroke-width="1.6"><rect x="38" y="12" width="212" height="144" /></g>
  <g fill="#fff" stroke="#8fd3ff" stroke-width="1.6">{[[38, 12], [250, 12], [38, 156], [250, 156]].map(([x, y]) => <rect x={x - 4} y={y - 4} width="8" height="8" />)}</g>
  <g transform="translate(106 164)"><rect width="76" height="20" rx="10" fill="#8fd3ff" /><text x="38" y="14" text-anchor="middle" font-family="Helvetica Neue, Helvetica, Arial, sans-serif" font-size="11" font-weight="700" fill="#0b263d">1440 × 900</text></g>
  <g transform="translate(0 132)"><g class="hx__float hx__float--c">
    <g filter="url(#r-sh)"><rect width="98" height="88" rx="15" fill="#fff" /></g>
    {[['Header', 0], ['Hero', 1], ['Cards', 2]].map(([n, i]) => (
      <g transform={`translate(14 ${18 + Number(i) * 22})`}>
        <circle cx="4" cy="0" r="4" fill="#2a79bd" /><rect x="14" y="-9" width={i === 0 ? 0 : 0} height="0" />
        <text x="16" y="4" font-family="Helvetica Neue, Helvetica, Arial, sans-serif" font-size="12" font-weight="600" fill="#0b263d">{n}</text>
      </g>
    ))}
  </g></g>
  <g transform="translate(206 -4) rotate(-8 29 29)"><g class="hx__float hx__float--b">
    <g filter="url(#r-sh)"><rect width="62" height="62" rx="18" fill="url(#r-red)" /></g>
    <rect x="2" y="2" width="58" height="30" rx="16" fill="url(#r-gloss)" />
    <text x="31" y="40" text-anchor="middle" font-family="ui-monospace, Menlo, monospace" font-size="21" font-weight="800" fill="#fff">&lt;/&gt;</text>
  </g></g>
  <g transform="translate(196 96)"><g class="hx__float hx__float--a">
    <path d="M0 0 L0 24 L7 18 L12 29 L17 27 L12 16 L21 16Z" fill="#8fd3ff" stroke="#fff" stroke-width="1.8" stroke-linejoin="round" />
    <g transform="translate(14 30)"><rect width="64" height="22" rx="11" fill="#8fd3ff" /><text x="32" y="15" text-anchor="middle" font-family="Helvetica Neue, Helvetica, Arial, sans-serif" font-size="11" font-weight="700" fill="#0a2a52">Studio</text></g>
  </g></g>
  <path d="M20 40 l3 9 9 3 -9 3 -3 9 -3 -9 -9 -3 9 -3z" fill="#ffd35c" />
</svg>
